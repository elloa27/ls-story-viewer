{
"60": "기뻐하는 것 같네.",
"61": "좋았어! 이름은 아서.\n결정된 걸로 박수~!",
"62": "스자쿠, 대단한 우연이네.",
"63": "같은 이름이라니, 역시 유페미아 님의 여동생\n이라는 걸까.",
"64": "뭐라고 했어?",
"65": "아니, 아무것도 아냐.",
"66": "를르슈. 무사히 고양이 이름도 정해졌으니,\n%난%난% 자율 연습 좀 하고 %올게%올게%.",
"67": "그래, 알았어.",
"68": "자율 연습?",
"69": "응. 게임 연습. 조금이라도 실력을 늘리고 싶어서.\n그럼 스자쿠, 나중에 봐.",
"70": "그래, 또 보자.",
"71": "\n힘내.",
"72": "%뭐지%어라%? 시뮬레이터가 움직이고 있어.\n누가 타고 있는 %거지%거지%?",
"73": "시뮬레이터에서 여자아이가……",
"74": "응? 넌 누구지?",
"75": "%너%당신%야말로 대체 누구%야%예요%?",
"0": "팬더는 어때요? 눈가가 까맣잖아요.",
"1": "저기요, 셜리 선배. 얜 고양이라고요?",
"2": "고양이지만 팬더인 거야! 귀엽잖아?",
"3": "헷갈리게스리.",
"4": "슈뢰딩거…….",
"5": "카렌은 뭐가 좋아?",
"6": "음…… 나비, 같은 건요?",
"7": "나비? 특이한 이름이네. 무슨 뜻이야?",
"8": "고양이 하면 '나비' 아닌가요?",
"9": "맥스웰…….",
"10": "야, 스자쿠는 생각 없어? 고양이 이름.",
"11": "아! 그럼, 아――",
"12": "대충 적당히 지어주면 안 될까요?",
"13": "안 돼! 정성을 담아 이름을 지어줘야\n마음이 통하는 법이야! 그러니까 타협은 일절 노!!",
"14": "디랙…….",
"15": "룰루는 뭐 없어?",
"16": "안 키운다에 한 표다.",
"17": "혹시 뒤끝 부리는 거야?",
"18": "시끄러워. 말 안 듣는 동물이 서툴 뿐이다.",
"19": "룰루는 고양이보단 개파잖아.",
"20": "거긴 남매라도 정반대구나.",
"21": "어?",
"22": "그러고 보니 스자쿠 군이 치료해 줬댔지, 이 아이.",
"23": "아뇨, 치료해 준 건 제가 아니라 같이 있던…….",
"24": "여자네.",
"25": "어떻게 아셨어요!?",
"26": "여자분? 어떤 사람? 어디서 만났어?",
"27": "　학생?\n연상? 군대 사람이야!?",
"28": "셜리, 너무 물고 늘어지잖아.",
"29": "참고로 우리 학생회는 들어올 때 연애담 하나는\n털어놓는 규칙이 있거든~.",
"30": "에에~익!!",
"31": "거짓말이다. 곧이듣지 마.",
"32": "\n스자쿠, 잠깐 이리 와 봐.",
"33": "아~잉, 도망쳤네ー.",
"34": "원래 저런 녀석들이야. 곧이곧대로 어울려 줄 거 없다.",
"35": "아냐. 다들 신경 써 주고 있는 거 아니까…….",
"36": "\n하지만, 더더욱 말하기 힘들어졌네.",
"37": "뭐가 말인데?",
"38": "저 고양이, 어떤 사람이 지어준 이름이 있거든.\n아서라고 하는데.",
"39": "어떤 사람이라면, 널 이 학원에 넣어준 사람 말이냐.",
"40": "\n그럼 그렇다고 말하면 되잖아.",
"41": "그렇긴 한데…….",
"42": "얘들아! 언제까지 귓속말만 하고 있을래?",
"43": "\n지금으로선 를르슈 2세라는 게 아슬아슬하게 유력하다고.",
"44": "기각입니다. 그것만큼은 절대로.",
"45": "\n누가 그런 걸 생각해서…….",
"46": "%나%나%……인데.",
"47": "너 진짜.",
"48": "\n그것보다, 녀석 이름 말인데――",
"49": "여러분, 안녕하세요.",
"50": "나나링.",
"51": "나나리, 오늘은 병원 가는 날이잖아?",
"52": "네, 그전에 아서한테 인사나 하려고요.",
"53": "\n냐냐~냐.",
"54": "냐~앙.",
"55": "에에~익!?",
"56": "아서라니…….",
"57": "고양이 이름이냐?",
"58": "네. 이 아이는 아서예요.",
"59": "냐~앙."
}